    {
      "id": 21,
      "title": "Réconciliation de l’offre",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "t3l4n-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((bridge_reconciliation_state == 1) and on(job, instance) (bridge:telemetry_fresh == 1) and on(job, instance) (time() - bridge_reconciliation_updated_timestamp_seconds <= 60) and on(job, instance) (time() - bridge_reconciliation_updated_timestamp_seconds >= -5) and on(job, instance) (bridge_ready == 1)) or (label_replace(vector(0),\"state\",\"Indisponible\",\"__name__\",\".*\") unless on() ((bridge_reconciliation_state == 1) and on(job, instance) (bridge:telemetry_fresh == 1) and on(job, instance) (time() - bridge_reconciliation_updated_timestamp_seconds <= 60) and on(job, instance) (time() - bridge_reconciliation_updated_timestamp_seconds >= -5) and on(job, instance) (bridge_ready == 1)))",
          "instant": true,
          "range": false,
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Indisponible",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Indisponible",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "balanced"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mismatch"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "inconclusive"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unavailable"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Indisponible"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "vertical",
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 20,
          "valueSize": 20
        }
      },
      "description": "balanced signifie que le contrôle effectué est équilibré sous ses hypothèses ; aucune preuve cryptographique du burn interchaîne n’en découle."
