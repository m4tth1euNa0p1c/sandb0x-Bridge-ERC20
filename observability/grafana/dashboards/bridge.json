{
  "uid": "t3l4n-bridge",
  "title": "T3l4N · exploitation locale",
  "description": "État réel exporté par le relayer local ; fraîcheur explicite et contrôles d’offre.",
  "tags": [
    "t3l4n",
    "sandbox",
    "local"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Sandbox de test — observations du relayer",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Actualisation demandée toutes les **5 s**. Lire d’abord **Disponibilité**, **Fraîcheur** et l’**heure UTC des données**. Les autres valeurs courantes sont masquées après 30 s sans mise à jour. Les courbes restent historiques ; une ligne passée n’atteste pas d’un service actif. Aucun réseau partagé n’est validé par ce tableau."
      }
    },
    {
      "id": 2,
      "title": "Collecte Prometheus → relayer",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "t3l4n-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"bridge\"}) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Indisponible",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Indisponible",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Indisponible",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 16,
          "valueSize": 22
        }
      }
    },
