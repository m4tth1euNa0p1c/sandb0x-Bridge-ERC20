# Inventaire non secret ; le CLI ne charge pas automatiquement ce fichier.
# Les profils locaux sont générés sous .local/runtime/<profil>/r2.
# Le profil d'intégration reste refusé, y compris si ce booléen est modifié ici.
BRIDGE_PROFILE=local-fast
BRIDGE_INTEGRATION_ENABLED=false
# À renseigner hors Git après vérification des prérequis, au jalon 5 :
TELA_CHAIN_ID=
TELA_GENESIS_HASH=
TELA_RPC_HTTP=
TELA_RPC_WS=
TELA_TOKEN_ADDRESS=
TELA_BRIDGE_ADDRESS=
SEPOLIA_RPC_HTTP=
SEPOLIA_GENESIS_HASH=
SEPOLIA_TOKEN_ADDRESS=
SEPOLIA_BRIDGE_ADDRESS=
# Variables des services locaux, injectées par Compose (pas de clé dans l'environnement) :
# BRIDGE_CONFIG=/config/deployment.json
# BRIDGE_SIGNER_URL=http://signer:8080
# BRIDGE_SIGNER_TOKEN_FILE=/run/secrets/signer_token
# Les clés sont des fichiers du compartiment de signature, jamais des valeurs ici.
