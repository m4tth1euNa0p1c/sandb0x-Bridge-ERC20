# Ce fichier documente les noms futurs ; aucune valeur secrète.
# Le CLI du jalon 1 ne charge pas de .env et n'accepte aucun RPC externe.
BRIDGE_PROFILE=local-fast
BRIDGE_INTEGRATION_ENABLED=false
# À renseigner hors Git après vérification des prérequis, au jalon 5 :
TELA_CHAIN_ID=
TELA_GENESIS_HASH=
TELA_RPC_HTTP=
TELA_RPC_WS=
TELA_TOKEN_ADDRESS=
TELA_BRIDGE_ADDRESS=
SEPOLIA_RPC_HTTP=
SEPOLIA_GENESIS_HASH=
SEPOLIA_TOKEN_ADDRESS=
SEPOLIA_BRIDGE_ADDRESS=
# Les clés seront des fichiers du compartiment de signature, jamais des valeurs ici.
