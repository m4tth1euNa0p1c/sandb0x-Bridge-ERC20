pragma solidity 0.8.30;

import {Bridge} from "../src/Bridge.sol";
import {BridgeToken} from "../src/BridgeToken.sol";
import {TestSupport} from "./TestSupport.sol";

contract BridgeDomainTest is TestSupport {
    Bridge internal bridge;
    bytes32 internal constant GOLDEN = 0x8bed238cdae717f48e865d0accc13b914d5dbb78a6c8a8dec0bdf1ef501fa5cf;
    address internal constant SOURCE_BRIDGE = 0x1111111111111111111111111111111111111111;
    address internal constant DESTINATION_BRIDGE = 0x2222222222222222222222222222222222222222;
    address internal constant SOURCE_TOKEN = 0x3333333333333333333333333333333333333333;
    address internal constant DESTINATION_TOKEN = 0x4444444444444444444444444444444444444444;
    address internal constant RECIPIENT = 0x5555555555555555555555555555555555555555;

    function setUp() public {
        BridgeToken token = new BridgeToken("Vector", "VEC", address(this), address(this), 0);
        bridge = new Bridge(address(token), address(this), address(2), address(3), 1 ether, 1 ether, 3600);
    }

    function testProtocolV1MatchesIndependentCastGoldenVector() public view {
        // Expected bytes are stored in vectors/transfer-id-v1.json, generated by cast abi-encode + keccak.
        assertEq(
            bridge.PROTOCOL_DOMAIN(),
            0x3a942dbf6b4a7f58d27abf99c27ef230da74301bf01e792eb591da2aa19232ab,
            "fixed protocol domain"
        );
        assertEq(bridge.PROTOCOL_VERSION(), 1, "fixed protocol version");
        assertEq(
            bridge.computeTransferId(
                31337, SOURCE_BRIDGE, 31338, DESTINATION_BRIDGE, SOURCE_TOKEN, DESTINATION_TOKEN, 7, 1 ether, RECIPIENT
            ),
            GOLDEN,
            "independent ABI vector"
        );
    }

    function testEveryMutableDomainFieldChangesTheId() public view {
        assertTrue(
            bridge.computeTransferId(
                31339, SOURCE_BRIDGE, 31338, DESTINATION_BRIDGE, SOURCE_TOKEN, DESTINATION_TOKEN, 7, 1 ether, RECIPIENT
            ) != GOLDEN,
            "source chain bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337, address(1), 31338, DESTINATION_BRIDGE, SOURCE_TOKEN, DESTINATION_TOKEN, 7, 1 ether, RECIPIENT
            ) != GOLDEN,
            "source bridge bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337, SOURCE_BRIDGE, 31339, DESTINATION_BRIDGE, SOURCE_TOKEN, DESTINATION_TOKEN, 7, 1 ether, RECIPIENT
            ) != GOLDEN,
            "destination chain bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337, SOURCE_BRIDGE, 31338, address(1), SOURCE_TOKEN, DESTINATION_TOKEN, 7, 1 ether, RECIPIENT
            ) != GOLDEN,
            "destination bridge bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337, SOURCE_BRIDGE, 31338, DESTINATION_BRIDGE, address(1), DESTINATION_TOKEN, 7, 1 ether, RECIPIENT
            ) != GOLDEN,
            "source token bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337, SOURCE_BRIDGE, 31338, DESTINATION_BRIDGE, SOURCE_TOKEN, address(1), 7, 1 ether, RECIPIENT
            ) != GOLDEN,
            "destination token bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337, SOURCE_BRIDGE, 31338, DESTINATION_BRIDGE, SOURCE_TOKEN, DESTINATION_TOKEN, 8, 1 ether, RECIPIENT
            ) != GOLDEN,
            "nonce bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337,
                SOURCE_BRIDGE,
                31338,
                DESTINATION_BRIDGE,
                SOURCE_TOKEN,
                DESTINATION_TOKEN,
                7,
                1 ether + 1,
                RECIPIENT
            ) != GOLDEN,
            "amount bound"
        );
        assertTrue(
            bridge.computeTransferId(
                31337, SOURCE_BRIDGE, 31338, DESTINATION_BRIDGE, SOURCE_TOKEN, DESTINATION_TOKEN, 7, 1 ether, address(1)
            ) != GOLDEN,
            "recipient bound"
        );
    }
}
