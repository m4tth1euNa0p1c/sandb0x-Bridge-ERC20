ARG SDK_IMAGE
FROM ${SDK_IMAGE}
ARG COMPONENT
WORKDIR /build
COPY global.json ./
COPY NuGet.config ./
COPY contracts/vectors/ ./contracts/vectors/
COPY src/Bridge.${COMPONENT}/ ./src/Bridge.${COMPONENT}/
COPY tests/Bridge.${COMPONENT}.Tests/ ./tests/Bridge.${COMPONENT}.Tests/
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_CLI_HOME=/tmp/dotnet
RUN dotnet restore tests/Bridge.${COMPONENT}.Tests/Bridge.${COMPONENT}.Tests.csproj --locked-mode
RUN dotnet build tests/Bridge.${COMPONENT}.Tests/Bridge.${COMPONENT}.Tests.csproj --no-restore -c Release
USER 1654:1654
